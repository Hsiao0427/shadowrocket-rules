# schema-version: 1
# ruleset-id: spacex
# services: ["Cursor","Grok (xAI)","X (Twitter)"]
# scope: First-party service domains for the Cursor editor and website, Grok chat/API and assets, X web/app and media, and official sign-in hosts shared by these services.
# excludes: SpaceX aerospace, Starlink, Tesla, unrelated AI services, and shared identity or CDN domains without service-specific ownership.
# managed-rule-types: ["DOMAIN","DOMAIN-SUFFIX"]
# format: Shadowrocket RULE-SET / Mihomo classical text
# update-policy: Review daily using the sources below. Prefer first-party evidence. Keep verified rules when evidence is inconclusive. Preserve order and non-domain rules. Commit only when domain rules change.
# source: https://cursor.com/help/troubleshooting/network
# source: https://cursor.com/help/troubleshooting/sign-in-domains
# source: https://docs.x.ai/grok/overview
# source: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/Twitter/Twitter.list

# Cursor
DOMAIN-SUFFIX,cursor.com
DOMAIN-SUFFIX,cursor.sh
DOMAIN-SUFFIX,cursor-cdn.com
DOMAIN-SUFFIX,cursorapi.com
DOMAIN-SUFFIX,cursorvm.com
DOMAIN,anysphere-binaries.s3.us-east-1.amazonaws.com
DOMAIN,agent-stores.s3.us-east-1.amazonaws.com
DOMAIN,agent-stores.s3.amazonaws.com
DOMAIN,cursor.blob.core.windows.net

# Grok and shared sign-in
DOMAIN-SUFFIX,grok.com
DOMAIN-SUFFIX,grokusercontent.com
DOMAIN-SUFFIX,x.ai
DOMAIN-SUFFIX,spacexsi.com
DOMAIN,accounts.spacex.ai
DOMAIN,auth.grokipedia.com

# X and related media
DOMAIN-SUFFIX,x.com
DOMAIN-SUFFIX,twitter.com
DOMAIN-SUFFIX,t.co
DOMAIN-SUFFIX,twimg.com
DOMAIN-SUFFIX,twimg.co
DOMAIN-SUFFIX,twimg.org
DOMAIN-SUFFIX,tweetdeck.com
DOMAIN-SUFFIX,twitteroauth.com
DOMAIN-SUFFIX,twitpic.com
